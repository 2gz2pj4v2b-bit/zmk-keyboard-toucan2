#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

#define BASE 0
#define NAV  1
#define SYM  2
#define ADJ  3

/*
 * Mod-Tap (&mt) - hier nur die obere Buchstabenreihe: Tap = Buchstabe, Halten = F1-F10.
 *
 * Standard in ZMK ist "hold-preferred" mit 200 ms. Dann loest schon ein schnelles
 * Ueberlappen beim Tippen (naechste Taste, waehrend die erste noch unten ist) die F-Taste aus.
 *
 * "tap-preferred": Die F-Taste kommt NUR, wenn die Taste allein so lange gehalten wird,
 * wie tapping-term-ms angibt. Jede andere Taste dazwischen macht es zum normalen Buchstaben.
 */

&mt {
    flavor = "tap-preferred";
    tapping-term-ms = <600>;
};

/ {
    conditional_layers {
        compatible = "zmk,conditional-layers";

        tri_layer {
            if-layers = <3 4>;
            then-layer = <5>;
        };
    };

    combos {
        compatible = "zmk,combos";

        RhinoLayer {
            bindings = <&tog 1>;
            key-positions = <4 5>;
        };

        blenderLayer {
            bindings = <&tog 2>;
            key-positions = <28 29>;
        };
    };

    behaviors {
        HMRShiftR: HMRShiftR {
            compatible = "zmk,behavior-hold-tap";
            label = "HMRSHIFTR";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            hold-while-undecided;
            hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38>;
            hold-trigger-on-release;
        };

        HML: HML {
            compatible = "zmk,behavior-hold-tap";
            label = "HML";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            hold-while-undecided;
            hold-trigger-on-release;
            hold-trigger-key-positions = <6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 39 40 41>;
            flavor = "tap-preferred";
        };

        HMR: HMR {
            compatible = "zmk,behavior-hold-tap";
            label = "HMR";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
            hold-while-undecided;
            hold-trigger-on-release;
            hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38>;
        };

        HMRShiftL: HMRShiftL {
            compatible = "zmk,behavior-hold-tap";
            label = "HMRSHIFTL";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            hold-trigger-key-positions = <6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 39 40 41>;
            hold-trigger-on-release;
            hold-while-undecided;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            display-name = "BASE";
            bindings = <
&mt ESC TAB  &mt F1 Q  &mt F2 W  &mt F3 E  &mt F4 R  &mt F5 T  &mt F6 Y  &mt F7 U  &mt F8 I  &mt F9 O  &mt F10 P  &kp BSPC  &kp LALT  &HML LEFT_CONTROL A  &HML LEFT_ALT S  &HMR LEFT_GUI D  &HMRShiftL LEFT_SHIFT F  &kp G  &kp H  &HMRShiftR RIGHT_SHIFT J  &HMR RIGHT_GUI K  &HMR RIGHT_ALT L  &kp LEFT_BRACE  &mt NON_US_HASH MINUS  &none  &kp Z  &kp X  &kp C  &kp V  &kp B  &kp N  &kp M  &kp COMMA  &kp DOT  &kp SEMICOLON  &kp APOS  &kp LEFT_GUI  &mo 3  &mt ENTER SPACE  &kp ENTER  &mo 4  &kp RALT
            >;
        };

        RhinoLayer {
            display-name = "RHI";
            bindings = <
&kp ESC  &kp LS(LC(LA(LG(Q))))  &kp LS(LC(LA(LG(W))))  &kp LS(LC(LA(LG(E))))  &kp LS(LC(LA(LG(R))))  &kp LS(LC(LA(LG(T))))  &trans  &trans  &trans  &trans  &trans  &trans  &kp LALT  &kp LS(LC(LA(LG(A))))  &kp LS(LC(LA(LG(S))))  &kp LS(LC(LA(LG(D))))  &kp LS(LC(LA(LG(F))))  &kp LS(LC(LA(LG(G))))  &trans  &trans  &trans  &trans  &trans  &trans  &kp LSHFT  &kp LG(Z)  &kp LS(LC(LA(LG(X))))  &kp LS(LC(LA(LG(C))))  &kp LS(LC(LA(LG(V))))  &kp LS(LC(LA(LG(B))))  &trans  &trans  &trans  &trans  &trans  &trans  &kp LGUI  &mo 3  &kp SPACE  &trans  &trans  &trans
            >;
        };

        BlenderLayer {
            display-name = "BLE";
            bindings = <
&kp ESC  &kp TAB  &kp X  &kp Y  &kp Z  &kp A  &trans  &trans  &trans  &trans  &trans  &trans  &kp LALT  &kp G  &kp R  &kp S  &kp E  &kp I  &trans  &trans  &trans  &trans  &trans  &trans  &kp LSHFT  &kp KP_N1  &kp KP_N3  &kp KP_N7  &kp KP_N5  &kp KP_DOT  &trans  &trans  &trans  &trans  &trans  &trans  &kp LGUI  &mo 3  &kp H  &trans  &trans  &trans
            >;
        };

        num {
            display-name = "num";
            bindings = <
&kp TAB  &kp LS(LG(N5))  &kp N7  &kp N8  &kp N9  &kp FSLH  &kp C_BRI_DEC  &kp C_BRI_INC  &kp K_MUTE  &kp C_VOL_DN  &kp C_VOLUME_UP  &kp BSPC  &studio_unlock  &kp LS(LG(NUMBER_4))  &kp NUMBER_4  &kp N5  &kp N6  &mt KP_DOT COMMA  &kp LEFT  &kp DOWN  &kp UP  &kp RIGHT  &bt BT_SEL 0  &bt BT_SEL 1  &kp LSHFT  &kp LS(LG(NUMBER_3))  &kp N1  &kp N2  &kp N3  &kp N0  &kp LS(LA(LG(LEFT_ARROW)))  &kp LS(LA(LG(DOWN_ARROW)))  &kp LS(LA(LG(UP_ARROW)))  &kp LS(LA(LG(RIGHT_ARROW)))  &bt BT_SEL 2  &bt BT_SEL 3  &kp LGUI  &trans  &kp SPACE  &kp RET  &trans  &kp RALT
            >;
        };

        sym {
            display-name = "SYM";
            bindings = <
&kp TAB  &kp EXCL  &kp AT  &kp HASH  &kp DLLR  &kp PRCNT  &kp CARET  &kp AMPS  &kp KP_MULTIPLY  &kp LPAR  &kp RPAR  &kp BSPC  &kp LCTRL  &trans  &trans  &trans  &trans  &trans  &kp MINUS  &kp EQUAL  &kp LBKT  &kp RBKT  &kp BSLH  &kp GRAVE  &kp LSHFT  &trans  &trans  &trans  &trans  &trans  &kp UNDER  &kp PLUS  &kp LBRC  &kp RBRC  &kp PIPE  &kp TILDE  &kp LGUI  &trans  &kp SPACE  &kp RET  &trans  &kp RALT
            >;
        };

        adj {
            display-name = "ADJ";
            bindings = <
&kp TAB  &trans  &kp F7  &kp F8  &kp F9  &kp F12  &kp C_VOL_DN  &kp C_MUTE  &kp C_VOL_UP  &trans  &trans  &kp BSPC  &kp LCTRL  &trans  &kp F4  &kp F5  &kp F6  &kp F11  &trans  &trans  &trans  &trans  &trans  &trans  &kp LSHFT  &trans  &kp F1  &kp F2  &kp F3  &kp F10  &trans  &trans  &trans  &trans  &trans  &trans  &kp LGUI  &mo 3  &kp SPACE  &kp RET  &mo 4  &kp RALT
            >;
        };

        layer_6 {
            display-name = "MOU";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        layer_7 {
            display-name = "MOU";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};
