#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define BASE 0
#define NAV  1
#define SYM  2
#define ADJ  3

/*
 * Mod-Tap (&mt) - hier nur die obere Buchstabenreihe: Tap = Buchstabe, Halten = F1-F10.
 *
 * Standard in ZMK ist "hold-preferred" mit 200 ms. Dann loest schon ein schnelles
 * Ueberlappen beim Tippen (naechste Taste, waehrend die erste noch unten ist) die F-Taste aus.
 *
 * "tap-preferred": Die F-Taste kommt NUR, wenn die Taste allein so lange gehalten wird,
 * wie tapping-term-ms angibt. Jede andere Taste dazwischen macht es zum normalen Buchstaben.
 */

&mt {
    flavor = "tap-preferred";
    tapping-term-ms = <600>;
};

/ {
    conditional_layers {
        compatible = "zmk,conditional-layers";

        tri_layer {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            display-name = "BASE";
            bindings = <
&kp ESC  &mt F1 Q  &mt F2 W  &mt F3 E  &mt F4 R  &mt F5 T  &mt F6 Y  &mt F7 U  &mt F8 I  &mt F9 O  &mt F10 P  &kp BSPC  &kp LALT  &kp A  &kp S  &kp D  &kp F  &kp G  &kp H  &kp J  &kp K  &kp L  &kp LBKT  &mt NUHS LG(MINUS)  &kp LSHFT  &kp Z  &kp X  &kp C  &kp V  &kp B  &kp N  &kp M  &kp COMMA  &kp DOT  &kp SEMI  &kp SQT  &kp LGUI  &mo 1  &kp SPACE  &kp RET  &mo 2  &kp RCTRL
            >;
        };

        num {
            display-name = "num";
            bindings = <
&kp TAB  &trans  &kp N7  &kp N8  &kp N9  &kp FSLH  &none  &none  &none  &none  &none  &kp BSPC  &trans  &trans  &mt LS(LG(N4)) LG(NUMBER_4)  &mt LS(LG(N5)) N5  &kp N6  &kp KP_DOT  &kp LEFT  &kp DOWN  &kp UP  &kp RIGHT  &bt BT_SEL 0  &bt BT_SEL 1  &kp LSHFT  &studio_unlock  &kp N1  &kp N2  &mt N3 LS(LG(NUMBER_3))  &kp N0  &kp LS(LA(LG(LEFT_ARROW)))  &kp LS(LA(LG(DOWN_ARROW)))  &kp LS(LA(LG(UP_ARROW)))  &kp LS(LA(LG(RIGHT_ARROW)))  &bt BT_SEL 3  &bt BT_SEL 4  &kp LGUI  &trans  &kp SPACE  &kp RET  &trans  &kp RALT
            >;
        };

        sym {
            display-name = "SYM";
            bindings = <
&kp TAB  &kp EXCL  &kp AT  &kp HASH  &kp DLLR  &kp PRCNT  &kp CARET  &kp AMPS  &kp KP_MULTIPLY  &kp LPAR  &kp RPAR  &kp BSPC  &kp LCTRL  &trans  &trans  &trans  &trans  &trans  &kp MINUS  &kp EQUAL  &kp LBKT  &kp RBKT  &kp BSLH  &kp GRAVE  &kp LSHFT  &trans  &trans  &trans  &trans  &trans  &kp UNDER  &kp PLUS  &kp LBRC  &kp RBRC  &kp PIPE  &kp TILDE  &kp LGUI  &trans  &kp SPACE  &kp RET  &trans  &kp RALT
            >;
        };

        adj {
            display-name = "ADJ";
            bindings = <
&kp TAB  &trans  &kp F7  &kp F8  &kp F9  &kp F12  &kp C_VOL_DN  &kp C_MUTE  &kp C_VOL_UP  &trans  &trans  &kp BSPC  &kp LCTRL  &trans  &kp F4  &kp F5  &kp F6  &kp F11  &trans  &trans  &trans  &trans  &trans  &trans  &kp LSHFT  &trans  &kp F1  &kp F2  &kp F3  &kp F10  &trans  &trans  &trans  &trans  &trans  &trans  &kp LGUI  &mo NAV  &kp SPACE  &kp RET  &mo 2  &kp RALT
            >;
        };

        mouse {
            display-name = "MOU";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &mkp MCLK  &mkp LCLK  &mkp RCLK  &mkp LCLK  &mkp RCLK  &mkp MCLK
            >;
        };

        extra_2 { status = "reserved"; };

        extra_3 { status = "reserved"; };
    };
};
